# Copy to .env on the server. Never commit real values.
NODE_ENV=production
DOMAIN=example.com

# Telegram
BOT_TOKEN=
# Comma-separated numeric Telegram IDs
ADMIN_TELEGRAM_IDS=
SUPPORT_TELEGRAM_IDS=
MINIAPP_URL=https://app.example.com

# Database / cache
POSTGRES_USER=iplast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iplast
DATABASE_URL=postgresql://iplast:change-me@postgres:5432/iplast?schema=public
REDIS_URL=redis://redis:6379

# API
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=3000
