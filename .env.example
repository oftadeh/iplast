# Copy to .env on the server. Never commit real values.
NODE_ENV=production
DOMAIN=example.com

# Telegram
BOT_TOKEN=
# Comma-separated numeric Telegram IDs
ADMIN_TELEGRAM_IDS=
SUPPORT_TELEGRAM_IDS=
MINIAPP_URL=https://app.example.com

# Database / cache
POSTGRES_USER=iplast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iplast
DATABASE_URL=postgresql://iplast:change-me@postgres:5432/iplast?schema=public
REDIS_URL=redis://redis:6379

# API
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=3000

# Order assistant (OpenAI). Leave OPENAI_API_KEY empty to turn it off.
OPENAI_API_KEY=
# Optional: a specific model id from your OpenAI project; empty = the Agents SDK default
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Shared secret for bot → API calls (generated by setup.sh)
INTERNAL_KEY=
API_INTERNAL_URL=http://api:3000/api
