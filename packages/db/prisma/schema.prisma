// iPlast data model. Prices are stored in Rial as BigInt.
// A missing price is NULL with status INQUIRY, never zero.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Catalog ─────────────

model Category {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  sortOrder Int             @default(0)
  parentId  String?
  parent    Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]      @relation("CategoryTree")
  families  ProductFamily[]
}

model Brand {
  id       String          @id @default(cuid())
  name     String          @unique
  families ProductFamily[]
}

model ProductFamily {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  specs       Json? // [["فشار کاری","۱۰ اتمسفر"], ...]
  badge       String? // پرفروش، جدید
  model       String? // e.g. IPT, قالب آلومینیومی
  unitName    String       @default("عدد")
  packName    String? // کارتن / کیسه / بسته
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id])
  axes        OptionAxis[]
  variants    Variant[]
  media       Media[]
  synonyms    Synonym[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model OptionAxis {
  id        String          @id @default(cuid())
  familyId  String
  family    ProductFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String // سایز لوله، سایز رزوه، فشار
  unit      String? // mm, inch, atm
  sortOrder Int             @default(0)
  values    VariantOption[]

  @@unique([familyId, name])
}

model Variant {
  id             String          @id @default(cuid())
  sku            String          @unique // internal, because accounting codes repeat
  accountingCode String? // کد کالا from the price list (NOT unique)
  title          String // original row text from the price list
  familyId       String
  family         ProductFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  perPack        Int? // تعداد در کارتن
  isActive       Boolean         @default(true)
  options        VariantOption[]
  prices         Price[]
  customerPrices CustomerPrice[]
  orderItems     OrderItem[]
  invoiceItems   InvoiceItem[]

  @@index([accountingCode])
}

model VariantOption {
  variantId String
  variant   Variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  axisId    String
  axis      OptionAxis @relation(fields: [axisId], references: [id], onDelete: Cascade)
  value     String

  @@id([variantId, axisId])
}

model Synonym {
  id       String         @id @default(cuid())
  term     String // نری، کوپلینگ، ...
  familyId String?
  family   ProductFamily? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([term])
}

model Media {
  id        String         @id @default(cuid())
  familyId  String?
  family    ProductFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  key       String // object-storage key
  mime      String
  width     Int?
  height    Int?
  isPrimary Boolean        @default(false)
  source    String? // e.g. "pdf:jame:p4" or "upload"
  createdAt DateTime       @default(now())
}

// ───────────── Pricing ─────────────

enum PriceListStatus {
  DRAFT // uploaded, waiting for review
  ACTIVE
  ARCHIVED
}

enum PriceStatus {
  PRICED
  INQUIRY // بزودی / * / missing → shown as «استعلامی»
}

model PriceList {
  id          String           @id @default(cuid())
  title       String // لیست قیمت آبان ۱۴۰۵
  sourceFile  String? // uploaded PDF/Excel key
  status      PriceListStatus  @default(DRAFT)
  validFrom   DateTime?
  publishedAt DateTime?
  publishedBy String?
  prices      Price[]
  importRows  PriceImportRow[]
  createdAt   DateTime         @default(now())
}

model Price {
  id          String      @id @default(cuid())
  priceListId String
  priceList   PriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  amount      BigInt? // Rial; NULL when status = INQUIRY
  status      PriceStatus @default(PRICED)
  note        String? // original text like «بزودی»

  @@unique([priceListId, variantId])
}

enum ImportMatch {
  MATCHED
  AMBIGUOUS
  NEW
  UNMATCHED
}

// One row parsed from an uploaded price-list PDF/Excel, kept for the diff preview.
model PriceImportRow {
  id             String      @id @default(cuid())
  priceListId    String
  priceList      PriceList   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  page           Int?
  familyTitle    String?
  rawText        String
  accountingCode String?
  perPack        Int?
  amount         BigInt?
  status         PriceStatus @default(PRICED)
  match          ImportMatch @default(UNMATCHED)
  variantId      String?
  resolvedBy     String?
}

model PriceGroup {
  id          String     @id @default(cuid())
  name        String     @unique // نماینده، عمده، ...
  discountPct Decimal    @default(0) @db.Decimal(5, 2)
  customers   Customer[]
}

model CustomerPrice {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  amount     BigInt
  validUntil DateTime?

  @@unique([customerId, variantId])
}

// ───────────── People ─────────────

enum StaffRole {
  ADMIN
  SALES // پشتیبان / کارشناس فروش
  WAREHOUSE // انبار: آماده‌سازی و ارسال سفارش‌های تأییدشده
}

model User {
  id           String           @id @default(cuid())
  telegramId   BigInt           @unique
  username     String?
  firstName    String?
  lastName     String?
  phone        String?
  staffRole    StaffRole? // set for admins and sales-support agents
  isActive     Boolean          @default(true)
  memberships  CustomerMember[]
  supportOf    Customer[]       @relation("AssignedSupport")
  ordersPlaced Order[]          @relation("PlacedBy")
  createdAt    DateTime         @default(now())
  lastSeenAt   DateTime?
}

enum CustomerType {
  RETAIL
  DEALER
  CONTRACTOR
}

model Customer {
  id            String           @id @default(cuid())
  name          String // company / shop name
  type          CustomerType     @default(RETAIL)
  city          String?
  address       String?
  nationalId    String?
  isApproved    Boolean          @default(false)
  priceGroupId  String?
  priceGroup    PriceGroup?      @relation(fields: [priceGroupId], references: [id])
  supportId     String? // fixed sales-support agent
  support       User?            @relation("AssignedSupport", fields: [supportId], references: [id])
  members       CustomerMember[]
  terms         PaymentTerms?
  prices        CustomerPrice[]
  orders        Order[]
  conversations Conversation[]
  invoices      Invoice[]
  payments      Payment[]
  documents     Document[]
  createdAt     DateTime         @default(now())
}

enum MemberRole {
  OWNER // مدیر حساب: sees all orders of the company
  BUYER // کارشناس خرید: places orders, sees own orders
  VIEWER
}

model CustomerMember {
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole @default(BUYER)
  addedAt    DateTime   @default(now())

  @@id([customerId, userId])
}

model Invite {
  id         String     @id @default(cuid())
  customerId String
  role       MemberRole @default(BUYER)
  token      String     @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdBy  String
}

// Cash/cheque terms set per customer in the admin panel; default in the customer cart.
model PaymentTerms {
  customerId      String   @id
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cashPercent     Int      @default(100) // 0..100; cheque = 100 - cash
  chequeDueDays   Int[]    @default([]) // e.g. [60, 90]
  cashDiscountPct Decimal  @default(0) @db.Decimal(5, 2)
  chequeMarkupPct Decimal  @default(0) @db.Decimal(5, 2)
  updatedBy       String?
  updatedAt       DateTime @updatedAt
}

// ───────────── Orders ─────────────

enum OrderStatus {
  SUBMITTED
  SALES_REVIEW
  SALES_APPROVED // approved by the customer's sales agent, waiting for the manager's final approval
  NEEDS_FIX
  PROFORMA_SENT
  PROFORMA_EXPIRED
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  REJECTED
  CANCELLED
}

model Order {
  id             String             @id @default(cuid())
  number         Int                @unique @default(autoincrement())
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  placedById     String
  placedBy       User               @relation("PlacedBy", fields: [placedById], references: [id])
  status         OrderStatus        @default(SUBMITTED)
  note           String?
  channel        String             @default("miniapp") // miniapp | bot | assistant | admin
  termsSnapshot  Json? // PaymentTerms at submit time
  priceListId    String?
  idempotencyKey String?            @unique
  items          OrderItem[]
  events         OrderStatusEvent[]
  proformas      Proforma[]
  invoices       Invoice[]
  shipments      Shipment[]
  documents      Document[]
  discount       BigInt             @default(0) // set by the sales agent on the proforma (Rial)
  shipping       BigInt             @default(0) // freight added to the proforma (Rial, paid in cash)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant     @relation(fields: [variantId], references: [id])
  title       String // snapshot
  quantity    Int // in units (عدد)
  packs       Int? // as entered by the customer, if by pack
  unitPrice   BigInt? // snapshot, NULL for inquiry items
  priceStatus PriceStatus
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  byUserId  String?
  comment   String?
  createdAt DateTime    @default(now())
}

model Proforma {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version    Int
  total      BigInt
  pdfKey     String?
  issuedBy   String
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime // default issuedAt + 48h
  acceptedAt DateTime?
  breakdown  Json? // applyTerms() result at issue time: cash / cheque parts, discounts, cheques
  items      Json? // [{title, quantity, packs, unitPrice}] as priced by the sales agent
  changed    Boolean   @default(false) // the agent changed prices or items, so the customer must accept it

  @@unique([orderId, version])
}

// ───────────── Bot conversations ─────────────

enum MessageKind {
  TEXT
  VOICE
  PHOTO
  DOCUMENT
}

enum MessageDirection {
  IN // from customer
  OUT // from staff/bot
}

model Conversation {
  id             String    @id @default(cuid())
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  userTelegramId BigInt
  assigneeId     String? // sales-support user id
  isOpen         Boolean   @default(true)
  // the AI sales agent answers until it hands the chat to a person (customer asks, a photo/file, or a case it can't handle)
  handoffAt      DateTime?
  handoffReason  String?
  messages       Message[]
  updatedAt      DateTime  @updatedAt

  @@index([userTelegramId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  kind           MessageKind
  text           String?
  telegramFileId String?
  fileKey        String? // copy in object storage
  byUserId       String?
  // where the bot copied this message in a support agent's chat, so a Reply there finds the customer
  relayChatId    BigInt?
  relayMessageId Int?
  createdAt      DateTime         @default(now())

  @@index([relayChatId, relayMessageId])
}

// ───────────── Misc ─────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // price.publish, terms.update, order.status ...
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model Setting {
  key   String @id
  value Json
}

// An order drafted by the AI assistant from a customer's text or voice; opened in the mini app cart.
model AssistantDraft {
  id        String    @id @default(cuid())
  userId    String
  source    String // miniapp | bot-text | bot-voice
  inputText String
  reply     String
  items     Json // [{variantId, quantity, mode, packs}]
  unclear   Json? // phrases the assistant could not match
  model     String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ───────── customer accounting: invoices issued, money received, balance ─────────

/// Sales invoice (فاکتور فروش). Usually issued from a confirmed order; amounts are frozen at issue time.
model Invoice {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  issuedById    String
  subtotal      BigInt // Rial
  discount      BigInt        @default(0)
  shipping      BigInt        @default(0)
  cashDiscount  BigInt        @default(0) // customer's cash discount (already taken off total)
  chequeMarkup  BigInt        @default(0) // customer's cheque markup (already added to total)
  total         BigInt
  cashPercent   Int           @default(100)
  chequeDueDays Int[]         @default([])
  note          String?
  cancelledAt   DateTime?
  items         InvoiceItem[]
  payments      Payment[]
  documents     Document[]

  @@index([customerId, issuedAt])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])
  title     String
  quantity  Int
  packs     Int?
  unitPrice BigInt
  total     BigInt
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

/// Money received from a customer: cash, bank transfer or a cheque (counted once it clears).
model Payment {
  id           String        @id @default(cuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  invoiceId    String?
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  amount       BigInt
  method       PaymentMethod
  status       PaymentStatus @default(CLEARED)
  chequeNumber String?
  bank         String?
  dueDate      DateTime? // cheque date (سررسید)
  receivedAt   DateTime      @default(now())
  note         String?
  receiptKey   String? // photo of the cheque or bank receipt (private upload)
  reportedById String? // customer user who sent it from the mini app
  createdById  String
  createdAt    DateTime      @default(now())
  remindedAt   DateTime? // last due-date reminder sent for this cheque
  documents    Document[]

  @@index([customerId, receivedAt])
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHEQUE
}

enum PaymentStatus {
  REPORTED // sent by the customer with a photo of the cheque/receipt, waiting for staff to check
  PENDING // cheque received, not cleared yet
  CLEARED
  BOUNCED // برگشتی
  CANCELLED
}

// ───────────── Announcements ─────────────

/// A message the manager sends through the bot to sales staff, customers, or one customer.
model Broadcast {
  id          String   @id @default(cuid())
  audience    String // sales | customers | all | customer
  customerId  String?
  text        String
  withButton  Boolean  @default(false) // adds an «open the shop» button for customers
  recipients  Int      @default(0)
  sent        Int      @default(0)
  failed      Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ───────────── Shipping and documents ─────────────

/// One load sent for an order (an order may go in several loads).
model Shipment {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  waybillNo   String? // شماره بارنامه
  carrier     String? // باربری
  driverName  String?
  driverPhone String?
  plate       String?
  freight     BigInt? // کرایه (Rial)
  freightBy   String? // customer | company
  note        String?
  shippedAt   DateTime   @default(now())
  createdById String
  documents   Document[]
}

enum DocKind {
  RECEIPT // فیش واریز
  CHEQUE // عکس چک
  INVOICE // فاکتور / پیش‌فاکتور امضاشده
  WAYBILL // بارنامه
  CONTRACT // قرارداد
  OTHER
}

/// A financial document (photo or PDF) kept on a customer's file, optionally tied to an order, payment, invoice or load.
model Document {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId    String?
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoiceId    String?
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  shipmentId   String?
  shipment     Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  kind         DocKind
  title        String?
  fileKey      String
  mime         String
  size         Int
  uploadedById String
  byCustomer   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
}
