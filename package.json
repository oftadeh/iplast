{
  "name": "iplast",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @iplast/db generate",
    "db:migrate": "pnpm --filter @iplast/db migrate:dev",
    "dev:api": "pnpm --filter @iplast/api dev",
    "dev:bot": "pnpm --filter @iplast/bot dev",
    "dev:miniapp": "pnpm --filter @iplast/miniapp dev",
    "dev:admin": "pnpm --filter @iplast/admin dev"
  }
}
