# Builds one Node service (api or bot) from the monorepo. Usage: --build-arg APP=api
FROM node:22-bookworm-slim AS build
ARG APP
WORKDIR /repo
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY . .
RUN pnpm install --frozen-lockfile \
 && pnpm --filter @iplast/shared build \
 && pnpm --filter @iplast/db build \
 && pnpm --filter "@iplast/${APP}" build \
 && pnpm --filter "@iplast/${APP}" deploy --legacy --prod /out \
 && cp -r packages/db/prisma /out/prisma \
 && if [ "$APP" = bot ] && [ -f apps/miniapp/public/intro.mp4 ]; then cp apps/miniapp/public/intro.mp4 /out/intro.mp4; fi \
 && cd /out && ./node_modules/.bin/prisma generate --schema prisma/schema.prisma

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates poppler-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
CMD ["node", "dist/main.js"]
