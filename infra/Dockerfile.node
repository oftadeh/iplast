# Builds one Node service (api or bot) from the monorepo. Usage: --build-arg APP=api
FROM node:22-bookworm-slim AS build
ARG APP
WORKDIR /repo
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @iplast/db build && pnpm --filter "@iplast/${APP}..." build
RUN pnpm deploy --filter "@iplast/${APP}" --prod /out && cp -r packages/db/prisma /out/prisma && cd /out && npx prisma@5.22.0 generate --schema prisma/schema.prisma

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
CMD ["node", "dist/main.js"]
