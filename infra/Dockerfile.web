# Builds the static mini app and admin panel and serves them with Caddy (automatic HTTPS).
FROM node:22-bookworm-slim AS build
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @iplast/miniapp build && pnpm --filter @iplast/admin build

FROM caddy:2.8
COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /repo/apps/miniapp/dist /srv/miniapp
COPY --from=build /repo/apps/admin/dist /srv/admin
